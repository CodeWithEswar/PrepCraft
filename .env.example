# ==========================================
# PrepCraft — Environment Variables Example
# ==========================================

# Supabase (Public / Browser-Safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key fallback, only if your project does not use publishable keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Application Base URL
NEXT_PUBLIC_APP_URL=
APP_ENV=local
NEXT_PUBLIC_APP_ENV=local
# Keep false for normal local development. Explicitly opt in only for an authorized live-project session.
ALLOW_LIVE_BACKEND=false
# Production value is documented in config/production.env.example.
PLATFORM_WORKER_URL=

# Brand inspection is development-only. Explicitly enable in a preview build if needed.
ENABLE_BRAND_PREVIEW=

# Optional monitoring. Reporting remains disabled without real DSNs.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_RELEASE=
# Server integrations; keep credentials out of NEXT_PUBLIC variables.
# Keep values in ignored local files or the deployment secret store.
SUPABASE_SECRET_KEY=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Execution service is a separate sandbox; no runtime is implemented here.
CODE_EXECUTION_API_URL=
CODE_EXECUTION_API_TOKEN=

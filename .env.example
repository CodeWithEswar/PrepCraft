# ==========================================
# PrepCraft — Environment Variables Example
# ==========================================

# Supabase (Public / Browser-Safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key fallback, only if your project does not use publishable keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Application Base URL
NEXT_PUBLIC_APP_URL=

# Brand inspection is development-only. Explicitly enable in a preview build if needed.
ENABLE_BRAND_PREVIEW=

# Future server integrations; unused until their implementation phase.
# Keep values in ignored local files or the deployment secret store.
SUPABASE_SECRET_KEY=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Execution service is a separate sandbox; no runtime is implemented here.
CODE_EXECUTION_API_URL=
CODE_EXECUTION_API_TOKEN=
